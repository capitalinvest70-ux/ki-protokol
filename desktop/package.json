{
  "name": "protokoli-ki",
  "productName": "Protokoli KI",
  "version": "2.9.0",
  "description": "Протоколи КИ – Програма за протокол с вида на Капитал Инвест",
  "author": "Капитал Инвест България",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "bg.capitalinvest.protokol",
    "productName": "Protokoli KI",
    "files": [
      "main.js",
      "preload.js",
      "skin.js",
      "print.js",
      "brand.js",
      "mobile.js",
      "mammoth.js",
      "html2canvas.min.js",
      "icon.png",
      "build.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "Protokoli-KI-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Протоколи КИ"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}